# Database Connection
DATABASE_URL=postgresql://naga:CHANGE_ME@127.0.0.1:5433/naga_thesis

# Application Port (default: 3000; Render injects PORT automatically)
PORT=3100

# Optional: set SEED_DEMO=true to seed presentation sample records on first initialization
SEED_DEMO=false

# Choose four-digit PINs before initializing a new database.
INITIAL_ADMIN_PIN=1234
INITIAL_PIN_ATT_001=1111
INITIAL_PIN_ATT_002=2222
INITIAL_PIN_ATT_003=3333
INITIAL_PIN_ATT_004=4444

# Optional cloud/proxy flags (auto-detected on Render)
# DATABASE_SSL=true
# TRUST_PROXY=1

# Optional local PostgreSQL launcher and backup-tool paths.
PG_BIN=
PG_DATA=
